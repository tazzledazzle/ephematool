load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go.bzl", "go_test")

go_library(
    name = "fakegithub",
    srcs = [
        "actions.go",
        "app.go",
        "registry.go",
        "repo.go",
        "server.go",
    ],
    importpath = "github.com/ephematool/ephematool/internal/fakegithub",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "fakegithub_test",
    srcs = [
        "actions_test.go",
        "repos_test.go",
        "server_test.go",
    ],
    embed = [":fakegithub"],
)
